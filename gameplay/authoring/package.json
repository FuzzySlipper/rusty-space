{
  "name": "@rusty-space/gameplay-authoring",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "materialize": "tsx src/materialize.ts && pnpm build && node scripts/materialize.mjs",
    "check": "tsx src/materialize.ts --check && pnpm build && node scripts/materialize.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rusty-engine/gameplay-rules-authoring": "file:../../../rusty-engine/rules/packages/gameplay-rules-authoring",
    "@rusty-engine/gameplay-rules-contracts": "file:../../../rusty-engine/rules/packages/gameplay-rules-contracts"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
