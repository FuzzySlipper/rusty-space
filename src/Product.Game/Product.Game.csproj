<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- The immutable SDK owns the generated CoreCLR and NativeAOT
         composition below obj. Engine source use is an explicit contributor
         override, never an adjacent-checkout default. -->
    <RustyEngineSdkPackageVersion>0.1.0-dev.681ec653ab6a</RustyEngineSdkPackageVersion>
    <RustyEngineProductEntryType>Rusty.Space.Product.SpaceProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-space</RustyEngineProductId>
    <RustyEngineProductTitle>Rusty Space</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui'))</RustyEngineProductUiRoot>
    <RustyEngineProductContentRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductUiProjectionStream>rusty-space</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>rusty.space.hud</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineWatchPaths>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineWatchPaths>
  </PropertyGroup>

  <!-- Product owners stay internal to the assembly; the test project exercises
       the same pure math the product runs, not a widened public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Product.Game.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="$(RustyEngineSdkPackageVersion)">
      <!-- An Engine contributor may explicitly supply a matching source
           project. The package remains the ordinary product default. -->
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
    <RustyEngineProductInputIntent Include="space.flight.thrust" Value="digital" />
    <RustyEngineProductInputIntent Include="space.flight.turn-left" Value="digital" />
    <RustyEngineProductInputIntent Include="space.flight.turn-right" Value="digital" />
    <RustyEngineProductInputIntent Include="space.flight.turn-left-controller" Value="digital" />
    <RustyEngineProductInputIntent Include="space.flight.turn-right-controller" Value="digital" />
    <RustyEngineProductInputIntent Include="space.flight.reset" Value="digital" />
    <RustyEngineProductInputIntent Include="space.flight.abort" Value="digital" />
    <RustyEngineProductInputIntent Include="space.flight.thrust-analog" Value="axis" />
    <RustyEngineProductInputIntent Include="space.flight.turn-analog" Value="axis" />
    <RustyEngineProductInputIntent Include="space.flight.coupling-trim" Value="axis" />
    <RustyEngineProductInputIntent Include="space.flight.couple" Value="digital" />
    <RustyEngineProductInputIntent Include="space.flight.uncouple" Value="digital" />
    <RustyEngineProductInputIntent Include="space.flight.emergency-uncouple" Value="digital" />
    <RustyEngineProductInputIntent Include="space.flight.stabilizer" Value="digital" />
    <RustyEngineProductInputIntent Include="space.flight.repair" Value="digital" />
    <RustyEngineProductInputIntent Include="space.camera.zoom" Value="axis" />
    <RustyEngineProductInputMapping Include="space.flight.thrust-held" Intent="space.flight.thrust" Trigger="key:key-w:held" />
    <RustyEngineProductInputMapping Include="space.flight.thrust-released" Intent="space.flight.thrust" Trigger="key:key-w:released" />
    <RustyEngineProductInputMapping Include="space.flight.turn-left-held" Intent="space.flight.turn-left" Trigger="key:key-a:held" />
    <RustyEngineProductInputMapping Include="space.flight.turn-left-released" Intent="space.flight.turn-left" Trigger="key:key-a:released" />
    <RustyEngineProductInputMapping Include="space.flight.turn-right-held" Intent="space.flight.turn-right" Trigger="key:key-d:held" />
    <RustyEngineProductInputMapping Include="space.flight.turn-right-released" Intent="space.flight.turn-right" Trigger="key:key-d:released" />
    <RustyEngineProductInputMapping Include="space.flight.reset-pressed" Intent="space.flight.reset" Trigger="key:key-r:pressed" />
    <RustyEngineProductInputMapping Include="space.flight.abort-pressed" Intent="space.flight.abort" Trigger="key:key-f:pressed" />
    <RustyEngineProductInputMapping Include="space.flight.couple-held" Intent="space.flight.couple" Trigger="key:key-e:held" />
    <RustyEngineProductInputMapping Include="space.flight.couple-released" Intent="space.flight.couple" Trigger="key:key-e:released" />
    <RustyEngineProductInputMapping Include="space.flight.uncouple-held" Intent="space.flight.uncouple" Trigger="key:key-q:held" />
    <RustyEngineProductInputMapping Include="space.flight.uncouple-released" Intent="space.flight.uncouple" Trigger="key:key-q:released" />
    <RustyEngineProductInputMapping Include="space.flight.emergency-uncouple-held" Intent="space.flight.emergency-uncouple" Trigger="key:key-x:held" />
    <RustyEngineProductInputMapping Include="space.flight.emergency-uncouple-released" Intent="space.flight.emergency-uncouple" Trigger="key:key-x:released" />
    <RustyEngineProductInputMapping Include="space.flight.stabilizer-pressed" Intent="space.flight.stabilizer" Trigger="key:key-t:pressed" />
    <RustyEngineProductInputMapping Include="space.flight.patch-held" Intent="space.flight.repair" Trigger="key:key-g:held" />
    <RustyEngineProductInputMapping Include="space.flight.patch-released" Intent="space.flight.repair" Trigger="key:key-g:released" />
    <RustyEngineProductInputMapping Include="space.flight.patch-controller-held" Intent="space.flight.repair" Trigger="controller-button:button-9:held" />
    <RustyEngineProductInputMapping Include="space.flight.patch-controller-released" Intent="space.flight.repair" Trigger="controller-button:button-9:released" />
    <RustyEngineProductInputMapping Include="space.flight.turn-left-controller-held" Intent="space.flight.turn-left-controller" Trigger="controller-button:button-4:held" />
    <RustyEngineProductInputMapping Include="space.flight.turn-left-controller-released" Intent="space.flight.turn-left-controller" Trigger="controller-button:button-4:released" />
    <RustyEngineProductInputMapping Include="space.flight.turn-right-controller-held" Intent="space.flight.turn-right-controller" Trigger="controller-button:button-5:held" />
    <RustyEngineProductInputMapping Include="space.flight.turn-right-controller-released" Intent="space.flight.turn-right-controller" Trigger="controller-button:button-5:released" />
    <RustyEngineProductInputMapping Include="space.flight.reset-controller-pressed" Intent="space.flight.reset" Trigger="controller-button:button-8:pressed" />
    <RustyEngineProductInputMapping Include="space.flight.thrust-controller-value" Intent="space.flight.thrust-analog" Trigger="controller-button-value:button-7" />
    <RustyEngineProductInputMapping Include="space.flight.turn-controller-axis" Intent="space.flight.turn-analog" Trigger="controller-axis:axis-0" />
    <RustyEngineProductInputMapping Include="space.flight.trim-controller-axis" Intent="space.flight.coupling-trim" Trigger="controller-axis:axis-1" />
    <RustyEngineProductInputMapping Include="space.camera.zoom-wheel" Intent="space.camera.zoom" Trigger="wheel:y" />
  </ItemGroup>
</Project>
