<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Immutable, installed Engine SDK artifact. An Engine source checkout
         is selected only through the explicit rusty dev override. -->
    <add key="rusty-engine-local" value=".runtime/sdk-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
