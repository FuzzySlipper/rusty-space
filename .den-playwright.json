{
  "project": "rusty-space",
  "serve": {
    "command": "pnpm run authoring:check && pnpm --dir apps/web build && cargo build -p rusty-space-host --bin browser-host --locked && exec target/debug/browser-host --addr {host}:{port}",
    "host": "127.0.0.1",
    "portRange": { "start": 4800, "end": 4899 },
    "healthUrl": "/health",
    "readyText": "rusty-space",
    "reusePolicy": "broker_owned",
    "startupTimeout": "60s",
    "healthInterval": "250ms"
  },
  "playtest": {
    "startPath": "/",
    "viewport": { "width": 1280, "height": 720 },
    "headed": false,
    "recordVideo": false
  },
  "tests": {
    "command": "pnpm --dir apps/web test:browser",
    "config": "apps/web/playwright.config.ts",
    "artifactPolicy": "live-ui"
  }
}
