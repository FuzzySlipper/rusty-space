{
  "project": "rusty-space",
  "serve": {
    "command": "PATH=\"$HOME/.local/bin:$PATH\" exec rusty dev --project ./src/Product.Game/Product.Game.csproj --live-debug --bind-host {host} --port {port}",
    "preferredPort": 0,
    "healthUrl": "/product-ui/main.js",
    "readyText": "Rusty Space",
    "reusePolicy": "broker_owned",
    "startupTimeout": "180s"
  },
  "playtest": {
    "startPath": "/",
    "viewport": {
      "width": 1280,
      "height": 720
    },
    "headed": false,
    "recordVideo": false
  }
}
